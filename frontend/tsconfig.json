{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "strict": true,
    "jsx": "preserve",
    "moduleResolution": "node16",
    // "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/main.js"],
  "exclude": ["node_modules"]
}